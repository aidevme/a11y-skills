{
  "name": "a11y-skills",
  "version": "0.0.1",
  "private": true,
  "description": "Multi-agent accessibility auditing plugin + skillset for React, Fluent UI v9, and Power Platform surfaces",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "reporters/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/framework-detector packages/rules-react packages/rules-fluent-ui packages/context-gen packages/runtime-axe reporters/markdown reporters/sarif reporters/html",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "docs:rules": "node packages/core/scripts/gen-rule-reference.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:manifests": "node scripts/check-manifests.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
